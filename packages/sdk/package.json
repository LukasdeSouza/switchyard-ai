{
  "name": "switchyard-sdk",
  "version": "1.0.0",
  "description": "Official TypeScript & JavaScript SDK for the Switchyard AI Gateway",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts"
  },
  "keywords": [
    "switchyard",
    "ai",
    "gateway",
    "router",
    "llm",
    "sdk",
    "anthropic",
    "gemini",
    "openai"
  ],
  "author": "Lucas de Souza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasdeSouza/switchyard-ai.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
